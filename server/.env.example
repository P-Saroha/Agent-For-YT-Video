# Environment variables for YouTube AI Assistant# OpenAI Configuration

# Copy this file to .env and fill in your actual API keysOPENAI_API_KEY=your_openai_api_key_here

OPENAI_MODEL=gpt-3.5-turbo

# Google Gemini API Key (for advanced Q&A)

GEMINI_API_KEY=your_gemini_api_key_here# YouTube Configuration (optional - for enhanced metadata)

YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube API Key (for video metadata, optional)

YOUTUBE_API_KEY=your_youtube_api_key_here# Server Configuration

DEBUG=True

# Server ConfigurationHOST=0.0.0.0

DEBUG=FalsePORT=8000

HOST=0.0.0.0

PORT=8000# Vector Store Configuration

VECTOR_STORE_PATH=store/faiss

# Vector Store ConfigurationEMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

VECTOR_STORE_PATH=store/faiss

EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2# Caching Configuration

CACHE_DIR=store/cache

# Caching ConfigurationCACHE_TTL=3600

CACHE_DIR=store/cache

# Chunking Configuration

# Optional: OpenAI API Key (if using OpenAI services)CHUNK_SIZE=1000

OPENAI_API_KEY=your_openai_api_key_hereCHUNK_OVERLAP=200


# Optional: HuggingFace API Key (if using HuggingFace Hub models)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here