# AI Content Analysis Platform - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =====================================================
# GOOGLE GEMINI API (REQUIRED)
# Get from: https://makersuite.google.com/app/apikey
# =====================================================
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# =====================================================
# YOUTUBE API (OPTIONAL - for video metadata)
# Get from: https://console.cloud.google.com/
# =====================================================
# YOUTUBE_API_KEY=your_youtube_api_key_here

# =====================================================
# SERVER CONFIGURATION
# =====================================================
DEBUG=True
HOST=0.0.0.0
PORT=8000

# =====================================================
# VECTOR STORE CONFIGURATION (FAISS)
# =====================================================
VECTOR_STORE_PATH=store/faiss
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =====================================================
# CACHING CONFIGURATION
# =====================================================
CACHE_DIR=store/cache
CACHE_TTL=3600

# =====================================================
# TEXT CHUNKING CONFIGURATION
# =====================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =====================================================
# YOUTUBE TRANSCRIPT FALLBACK (yt-dlp)
# =====================================================
# Enable yt-dlp as fallback for transcript extraction (1/true/yes/on)
YT_FORCE_YTDLP=1

# Preferred subtitle languages (comma separated)
YT_SUB_LANGS=en,en-US,a.en,hi,es

# Optional: Path to Netscape-format cookies.txt file to bypass YouTube restrictions
# Example: F:\cookies.txt
# YT_COOKIES_FILE=

# Optional: HTTP/SOCKS proxy to bypass regional blocking
# Example: http://proxy.example.com:8080 or socks5://127.0.0.1:1080
# YT_PROXY=
