{
  "name": "youtube-ai-assistant",
  "version": 2,
  "builds": [
    {
      "src": "server/vercel_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "server/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server/vercel_app.py"
    }
  ]
}