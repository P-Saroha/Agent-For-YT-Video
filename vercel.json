{
  "version": 2,
  "builds": [
    {
      "src": "server/vercel_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "server/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server/vercel_app.py"
    }
  ],
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "DEBUG": "False",
    "HOST": "0.0.0.0",
    "PORT": "8000"
  },
  "functions": {
    "server/vercel_app.py": {
      "maxDuration": 30
    }
  }
}